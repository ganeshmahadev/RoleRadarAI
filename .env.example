# Copy to .env for local (non-Docker) runs. Never commit .env.
# Postgres/Redis come from `docker compose up -d postgres redis` (host ports 5433 / 6379).
DATABASE_URL=postgresql+psycopg://roleradar:roleradar@localhost:5433/roleradar
REDIS_URL=redis://localhost:6379/0

# OpenJev runs natively on the macOS host with MLX (never in Docker).
# Inside Docker Compose the API uses http://host.docker.internal:4100 instead.
OPENJEV_BASE_URL=http://localhost:4100
OPENJEV_MODEL=openjev/openjev-MLX-4bit

# Resume files (outside any web root). Relative paths resolve from where the API runs (apps/api).
# Docker Compose overrides this with a named volume at /var/lib/roleradar/uploads.
UPLOAD_DIR=./uploads
APP_ENV=development

GENERATION_PROVIDER=
GENERATION_API_KEY=

# Frontend (browser → FastAPI)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
